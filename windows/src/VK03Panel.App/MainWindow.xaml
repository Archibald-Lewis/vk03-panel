<Window x:Class="VK03Panel.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VK03Panel.App"
        Title="VK03 副屏监控"
        Width="1000"
        Height="720"
        MinWidth="860"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource AppBackgroundBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type local:NavItem}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Glyph}"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="15"
                           Width="24"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding Title}" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar"
              Grid.Row="0"
              Background="Transparent"
              MouseLeftButtonDown="OnTitleBarMouseDown">
            <StackPanel Orientation="Horizontal"
                        Margin="14,0,0,0"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False">
                <Border Width="16" Height="16" CornerRadius="4" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                <TextBlock Text="VK03 副屏监控"
                           FontSize="12"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0">
                <Button x:Name="MinimizeButton"
                        Style="{StaticResource CaptionButton}"
                        Click="OnMinimizeClicked"
                        ToolTip="最小化">
                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1"
                          Data="M0,0 H10"
                          SnapsToDevicePixels="True" />
                </Button>
                <Button x:Name="MaximizeButton"
                        Style="{StaticResource CaptionButton}"
                        Click="OnMaximizeClicked"
                        ToolTip="最大化">
                    <Path x:Name="MaximizeGlyph"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1"
                          Data="M0,0 H10 V10 H0 Z"
                          SnapsToDevicePixels="True" />
                </Button>
                <Button x:Name="CloseButton"
                        Style="{StaticResource CloseCaptionButton}"
                        Click="OnCloseClicked"
                        ToolTip="关闭到托盘">
                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1"
                          Data="M0,0 L10,10 M10,0 L0,10"
                          SnapsToDevicePixels="True" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource NavBackgroundBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,1,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="设置"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="18,14,0,4"
                               Foreground="{DynamicResource TextPrimaryBrush}" />

                    <ListBox x:Name="NavList"
                             Grid.Row="1"
                             Margin="0,4,0,0"
                             Style="{StaticResource NavListBox}"
                             ItemContainerStyle="{StaticResource NavItem}"
                             SelectionChanged="OnNavSelectionChanged" />

                    <Border Grid.Row="2"
                            Padding="16,12"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="0,1,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot"
                                         Width="8"
                                         Height="8"
                                         VerticalAlignment="Center"
                                         Fill="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock x:Name="StatusText"
                                           Text="正在启动…"
                                           FontSize="11"
                                           Margin="8,0,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock x:Name="StatusDetail"
                                       Text=""
                                       FontSize="10"
                                       Margin="0,4,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="28,16,28,28">
                <ContentControl x:Name="PageHost"
                                HorizontalAlignment="Left"
                                Focusable="False" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>

<UserControl x:Class="VK03Panel.App.UI.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="820" HorizontalAlignment="Left">
        <TextBlock Text="关于" Style="{StaticResource PageTitle}" />
        <TextBlock Style="{StaticResource PageSubtitle}"
                   Text="VK03 副屏监控 · Windows 版：把机箱 USB 小屏变成监控与触控面板，并内置 macOS 与 Windows 11 两套主题。" />

        <TextBlock Text="应用" Style="{StaticResource SectionTitle}" Margin="2,4,0,8" />
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Grid>
                    <TextBlock Text="版本" Style="{StaticResource RowTitle}" />
                    <TextBlock x:Name="VersionText" HorizontalAlignment="Right" Style="{StaticResource RowDescription}" Margin="0" />
                </Grid>
                <Border Style="{StaticResource Divider}" />
                <Grid>
                    <TextBlock Text="副屏设备" Style="{StaticResource RowTitle}" />
                    <TextBlock x:Name="DeviceText" HorizontalAlignment="Right" Style="{StaticResource RowDescription}" Margin="0" Text="等待连接" MaxWidth="520" TextWrapping="Wrap" />
                </Grid>
                <Border Style="{StaticResource Divider}" />
                <Grid>
                    <TextBlock Text="副屏主题" Style="{StaticResource RowTitle}" />
                    <TextBlock x:Name="ThemeText" HorizontalAlignment="Right" Style="{StaticResource RowDescription}" Margin="0" />
                </Grid>
                <Border Style="{StaticResource Divider}" />
                <Grid>
                    <TextBlock Text="数据源" Style="{StaticResource RowTitle}" />
                    <TextBlock x:Name="SourceText" HorizontalAlignment="Right" Style="{StaticResource RowDescription}" Margin="0" />
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock Text="本地数据" Style="{StaticResource SectionTitle}" Margin="2,8,0,8" />
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource RowDescription}" Margin="0,0,0,6"
                           Text="配置保存在 %APPDATA%\VK03Panel\config.json；预览、指标与日志保存在 %LOCALAPPDATA%\VK03Panel\。程序不会上传任何数据，也没有遥测服务器。" />
                <TextBlock x:Name="DataPathText" Style="{StaticResource RowDescription}" Margin="0" />
            </StackPanel>
        </Border>

        <TextBlock Text="链接" Style="{StaticResource SectionTitle}" Margin="2,8,0,8" />
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="打开项目主页（Gitee）" Style="{StaticResource SubtleButton}" Margin="0,0,8,0" Tag="https://gitee.com/archibald-lewis/vk03-panel-macos" Click="OnOpenLink" />
                    <Button Content="打开配置文件夹" Style="{StaticResource SubtleButton}" Click="OnOpenConfigFolder" />
                </StackPanel>
                <TextBlock Style="{StaticResource RowDescription}" Margin="0"
                           Text="界面与渲染代码采用 MIT 许可；USB 协议研究来自 codehz/msdisplay；原版 macOS 应用为同一项目的来源。第三方组件许可见 THIRD_PARTY_NOTICES.md。" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>

<UserControl x:Class="VK03Panel.App.UI.Pages.DisplayPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="820" HorizontalAlignment="Left">
        <TextBlock Text="副屏" Style="{StaticResource PageTitle}" />
        <TextBlock Style="{StaticResource PageSubtitle}"
                   Text="VK03 副屏的实时预览、安装方向与连接状态。关闭窗口后程序仍在托盘中运行。" />

        <Border Style="{StaticResource Card}" Padding="14">
            <StackPanel>
                <Border x:Name="PreviewFrame"
                        CornerRadius="6"
                        Background="{DynamicResource CardBackgroundBrush}"
                        ClipToBounds="True"
                        Height="262"
                        Cursor="Hand"
                        MouseLeftButtonDown="OnPreviewMouseDown"
                        MouseLeftButtonUp="OnPreviewMouseUp"
                        MouseMove="OnPreviewMouseMove">
                    <Grid>
                        <Image x:Name="PreviewImage"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock x:Name="PreviewPlaceholder"
                                   Text="正在渲染首帧…"
                                   FontSize="12"
                                   Foreground="#8FA0B8"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Grid Margin="2,10,2,0">
                    <TextBlock Text="点击预览可模拟触控：静音、音量、切歌、按住锁屏"
                               FontSize="11"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock Text="方向" Style="{StaticResource SectionTitle}" Margin="2,10,0,8" />
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="面板安装方向" Style="{StaticResource RowTitle}" />
                    <TextBlock Text="90° 是实机验证的横屏方向；切换后画面与触控映射会同步更新。"
                               Style="{StaticResource RowDescription}" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource SegmentGroup}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="Rotation0" GroupName="Rotation" Style="{StaticResource SegmentRadio}" Content="0°" Tag="0" Checked="OnRotationChecked" />
                        <RadioButton x:Name="Rotation90" GroupName="Rotation" Style="{StaticResource SegmentRadio}" Content="90°" Tag="90" Checked="OnRotationChecked" />
                        <RadioButton x:Name="Rotation180" GroupName="Rotation" Style="{StaticResource SegmentRadio}" Content="180°" Tag="180" Checked="OnRotationChecked" />
                        <RadioButton x:Name="Rotation270" GroupName="Rotation" Style="{StaticResource SegmentRadio}" Content="270°" Tag="270" Checked="OnRotationChecked" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <TextBlock Text="连接" Style="{StaticResource SectionTitle}" Margin="2,10,0,8" />
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="USB 副屏" Style="{StaticResource RowTitle}" />
                        <TextBlock x:Name="DeviceText" Style="{StaticResource RowDescription}" Text="等待副屏连接…" />
                    </StackPanel>
                    <Button Content="重新连接"
                            Grid.Column="1"
                            Style="{StaticResource SubtleButton}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="OnReconnectClicked" />
                </Grid>
                <Border Style="{StaticResource Divider}" />
                <TextBlock x:Name="ErrorText"
                           Style="{StaticResource RowDescription}"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           Text="接通副屏 USB 后会自动初始化；若厂商程序正在使用副屏，请先退出该程序。" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
